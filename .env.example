# Conexion a la misma base de datos SQL Server que usa InventX (escritorio)
DB_SERVER=MacBook-Pro-de-Junior.local
DB_PORT=3315
DB_NAME=ventas
DB_USER=sa
DB_PASSWORD=
# true si el servidor exige cifrado (Azure); en LAN normalmente false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Secreto para firmar la cookie de sesion (minimo 32 caracteres aleatorios)
SESSION_SECRET=cambie-esto-por-un-secreto-largo-y-aleatorio

# Zona horaria (nombre de Windows) para las fechas de las ventas. Ecuador = SA Pacific Standard Time.
# Dejar vacio para usar la hora del servidor SQL.
DB_TIMEZONE=SA Pacific Standard Time

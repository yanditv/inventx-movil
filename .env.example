# Conexion a la base SQL Server de InventX (escritorio).
# En la PC de la tienda (mismo equipo que SQL Server):
#   instancia predeterminada  -> DB_SERVER=localhost  y DB_PORT=1433
#   instancia con nombre      -> DB_SERVER=localhost\SQLEXPRESS  y DB_PORT vacio (requiere SQL Server Browser)
# SQL Server debe tener TCP/IP habilitado (SQL Server Configuration Manager).
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ventas
# Usuario SQL (no de Windows)
DB_USER=sa
DB_PASSWORD=
# true si el servidor exige cifrado (Azure); en la misma PC o LAN normalmente false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Secreto para firmar la cookie de sesion: minimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Zona horaria (nombre de Windows) para las fechas de las ventas. Ecuador = SA Pacific Standard Time.
# Dejar vacio para usar la hora del servidor SQL.
DB_TIMEZONE=SA Pacific Standard Time

# Direccion publica de la app (por ejemplo https://inventx.mi-red.ts.net). Si existe, el QR de la terminal apunta aqui.
APP_URL=
